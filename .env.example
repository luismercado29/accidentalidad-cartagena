# Copia este archivo como .env.local para desarrollo. Nada de esto es obligatorio en local:
# sin DATABASE_URL se usa PGlite (Postgres embebido en .pglite/).

# Postgres (Neon en produccion)
DATABASE_URL=

# Firma de las sesiones (obligatoria en produccion). Genera una con: openssl rand -base64 48
AUTH_SECRET=

# Claves iniciales de las cuentas del equipo (solo se usan al crearlas por primera vez)
CLAVE_ADMIN=
CLAVE_SUPERVISOR=
CLAVE_OPERADOR=
CLAVE_ANALISTA=

# Mapas: token PUBLICO de Mapbox (pk.*), restringido por dominio. Sin token se usan teselas de CARTO.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Asistente IA via Vercel AI Gateway (en Vercel basta con el OIDC del proyecto). Sin clave: modo por reglas.
AI_GATEWAY_API_KEY=

# Cron de fuentes externas (Vercel envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# WhatsApp via Twilio (opcional): valida la firma del webhook /api/whatsapp
TWILIO_AUTH_TOKEN=
